# firewall4: sets
#
# Instead of one rule per port or address, nftables has sets:
#   anonymous:  tcp dport { 22, 80, 443 } accept
#   named:      set blocklist { type ipv4_addr; elements = { ... } }
#               ... ip saddr @blocklist drop
# Named sets can be changed at runtime without touching the rules:
#   nft add element inet filter blocklist { 10.0.0.9 }
#
# Same switch as before: this ruleset goes on h1 (10.0.0.1), which runs
# services on 22, 80, 443, 8080 and 9000. The check expects:
#   h2 (10.0.0.2): reaches 22, 80, 443 and 8080, ping works, 9000 is closed
#   h3 (10.0.0.3): on the blocklist, reaches nothing at all
#
# Your task: two things are wrong. 8080 was never opened, and the blocklist
# rule looks at the wrong end of the packet.

flush ruleset

table inet filter {
  set blocklist {
    type ipv4_addr
    elements = { 10.0.0.3 }
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif lo accept
    ip daddr @blocklist drop
    ct state established,related accept
    tcp dport { 22, 80, 443 } accept
    icmp type echo-request accept
  }
}

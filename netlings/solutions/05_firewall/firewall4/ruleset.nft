# firewall4: sets

flush ruleset

table inet filter {
  set blocklist {
    type ipv4_addr
    elements = { 10.0.0.3 }
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif lo accept
    ip saddr @blocklist drop
    ct state established,related accept
    tcp dport { 22, 80, 443, 8080 } accept
    icmp type echo-request accept
  }
}
